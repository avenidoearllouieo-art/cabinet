# Django reads these values from the process environment.
DJANGO_SECRET_KEY=replace-with-a-long-random-production-secret
DEVICE_API_KEY=replace-with-development-device-key
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5176,http://127.0.0.1:5176
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5176,http://127.0.0.1:5176
TAPTRACK_NFC_REGISTRATION_URL_BASE=http://localhost:5176/register
TAPTRACK_CABINET_NAME=Cabinet 1
TAPTRACK_CABINET_STATIONS=Station 1,Station 2
# Each physical NFC reader has its own unique, server-side identity and key.
TAPTRACK_NFC_DEVICE_MAP=[{"device_id":"CABINET1-STATION1","api_key":"replace-with-reader-1-key","station":"Station 1","cabinet_name":"Cabinet 1","active":true},{"device_id":"CABINET1-STATION2","api_key":"replace-with-reader-2-key","station":"Station 2","cabinet_name":"Cabinet 1","active":true}]