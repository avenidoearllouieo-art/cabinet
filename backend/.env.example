# Django reads these values from the process environment.
DJANGO_SECRET_KEY=replace-with-a-long-random-production-secret
DEVICE_API_KEY=replace-with-development-device-key
# Enable only for local development; keep false in deployed environments.
DJANGO_DEBUG=true
# Development hostnames/IPs. Add only clients that should reach this Django server.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,192.168.1.43,testserver
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5176,http://127.0.0.1:5176,http://localhost:5177,http://127.0.0.1:5177
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5176,http://127.0.0.1:5176,http://localhost:5177,http://127.0.0.1:5177
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SECURE_HSTS_SECONDS=0
# Leave media storage on the local filesystem for development. Render uses a private S3-compatible bucket.
DJANGO_MEDIA_STORAGE_BACKEND=filesystem
DJANGO_MEDIA_ROOT=
DJANGO_FILE_UPLOAD_TEMP_DIR=
# Production-only object storage values. Never commit real credentials.
AWS_STORAGE_BUCKET_NAME=taptrack-files
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION_NAME=auto
AWS_S3_ENDPOINT_URL=https://t3.storage.dev
AWS_S3_ADDRESSING_STYLE=virtual
# Direct browser multipart upload limits. Values are bytes except the TTLs.
TAPTRACK_MAX_STUDENT_VIDEO_BYTES=5368709120
TAPTRACK_MAX_STUDENT_SUBMISSION_BYTES=10737418240
TAPTRACK_MULTIPART_PART_SIZE=33554432
TAPTRACK_MULTIPART_SESSION_TTL=86400
TAPTRACK_PRESIGNED_PART_URL_TTL=900
# Set this temporarily when migrating old local uploads that still exist.
DJANGO_LEGACY_MEDIA_ROOT=
# Use the deployed HTTPS frontend URL in Render; local DEBUG uses localhost:5176.
TAPTRACK_NFC_REGISTRATION_URL_BASE=http://localhost:5176/register
DJANGO_EMAIL_HOST=
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_EMAIL_USE_TLS=true
DJANGO_DEFAULT_FROM_EMAIL=
TAPTRACK_CABINET_NAME=Cabinet 1
TAPTRACK_CABINET_STATIONS=Station 1,Station 2
# The Pi and shared NFC reader authenticate as the Cabinet, not a logical station.
TAPTRACK_NFC_DEVICE_MAP=[{"device_id":"CABINET1-PI","api_key":"replace-with-reader-api-key","cabinet_name":"Cabinet 1","active":true}]