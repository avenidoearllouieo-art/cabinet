# Install as /etc/taptrack/nfc.env with restrictive permissions (0600).
# This file is read only by taptrack-nfc.service. Never put the key in VITE_ vars.
# Use one unique key for the Pi's shared reader and map it to its Cabinet in Django.
DEVICE_API_KEY=replace-with-reader-api-key
TAPTRACK_DJANGO_VERIFY_URL=http://127.0.0.1:8000/api/verify-nfc/
TAPTRACK_NFC_MODE=hardware
TAPTRACK_NFC_DB_PATH=/home/pi/tap-track/pi_service/nfc_events.sqlite3