# Install as /etc/taptrack/nfc.env with restrictive permissions (0600).
# This file is read only by taptrack-nfc.service. Never put the key in VITE_ vars.
# Use one unique key for the Pi's shared reader and map it to its Cabinet in Django.
DEVICE_API_KEY=replace-with-reader-api-key
# Set this to the same Django API deployment/database used by the Portal.
# Leave unset only when Django is running on this same Pi.
# TAPTRACK_DJANGO_API_BASE_URL=http://<same-django-host>:8000/api
# Exact deployed Cabinet browser Origin; add another only if intentionally used.
TAPTRACK_NFC_ALLOWED_ORIGINS=http://localhost:4000
# Legacy endpoint override used only when TAPTRACK_DJANGO_API_BASE_URL is unset.
TAPTRACK_DJANGO_VERIFY_URL=http://127.0.0.1:8000/api/verify-nfc/
TAPTRACK_NFC_MODE=hardware
TAPTRACK_NFC_DB_PATH=/home/taptrack/tap-track/pi_service/nfc_events.sqlite3
TAPTRACK_MOTOR_MODE=serial
TAPTRACK_MOTOR_SERIAL_DEVICE=/dev/serial/by-id/usb-1a86_USB_Single_Serial_5CBD018279-if00
TAPTRACK_MOTOR_BAUD_RATE=115200
TAPTRACK_MOTOR_RESPONSE_TIMEOUT_SECONDS=10
TAPTRACK_MOTOR_ACTUATION_ENABLED=false

# Serial mode selects the real controller, but does not open the port or send
# commands while actuation remains disabled. Verify the exact path on this Pi:
# ls -l /dev/serial/by-id/
# Actuation may only be enabled after the complete physical-safety review.
# If approved, all three confirmations must be true, and the operator must
# run motor_recovery.py after every service start before any workflow can move.
# TAPTRACK_MOTOR_ACTUATION_ENABLED=true
# TAPTRACK_MOTOR_LIMIT_SWITCHES_INSTALLED=true
# TAPTRACK_MOTOR_ESTOP_INSTALLED=true
# TAPTRACK_MOTOR_RECOVERY_PROCEDURE_APPROVED=true

# Leave these false/unset unless each safety measure is independently
# installed, tested, and documented. Actuation remains disabled above.
# TAPTRACK_MOTOR_LIMIT_SWITCHES_INSTALLED=false
# TAPTRACK_MOTOR_ESTOP_INSTALLED=false
# TAPTRACK_MOTOR_RECOVERY_PROCEDURE_APPROVED=false
