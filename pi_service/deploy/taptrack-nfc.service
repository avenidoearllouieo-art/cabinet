[Unit]
Description=TapTrack NFC reader and scan bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=taptrack
WorkingDirectory=/home/taptrack/tap-track/pi_service
EnvironmentFile=-/etc/taptrack/nfc.env
ExecStart=/home/taptrack/tap-track/pi_service/.venv/bin/python /home/taptrack/tap-track/pi_service/nfc_service.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target