[Unit]
Description=TapTrack NFC reader service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/apps/taptrack-cabinet/pi_service
EnvironmentFile=-/etc/taptrack/cabinet.env
ExecStart=/home/pi/apps/taptrack-cabinet/pi_service/.venv/bin/python nfc_service.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
