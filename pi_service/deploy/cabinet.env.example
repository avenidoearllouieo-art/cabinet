# Copy this to /etc/taptrack/cabinet.env on the Raspberry Pi.

# Cabinet server proxies same-origin requests to the Pi-local bridge. The
# Django device key stays in the NFC service environment, never in VITE_ vars.
VITE_NFC_BRIDGE_URL=/nfc-bridge/api/scans
VITE_NFC_MODE=hardware
# If Django does not run on this Pi, set its actual reachable API URL before build.
# VITE_DJANGO_API_BASE_URL=http://<django-host>:8000/api

# Cabinet UI runtime.
HOST=127.0.0.1
PORT=4000
