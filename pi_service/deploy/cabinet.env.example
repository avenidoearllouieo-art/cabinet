# Copy this to /etc/taptrack/cabinet.env on the Raspberry Pi.

# Cabinet reads scan results from the local bridge. The Django device key
# stays in the Pi listener environment and must never be placed in VITE_ vars.
VITE_NFC_BRIDGE_URL=http://127.0.0.1:5001/api/scans
VITE_NFC_MODE=hardware

# Cabinet UI runtime.
HOST=127.0.0.1
PORT=4000
