# Copy this to /etc/taptrack/cabinet.env on the Raspberry Pi
# and replace the placeholders with the actual machine addresses.

# Django server on the network, NOT localhost unless Django runs on the Pi itself.
VITE_DJANGO_API_BASE_URL=http://192.168.1.100:8000/api
VITE_DJANGO_API_KEY=replace-with-device-api-key
VITE_DJANGO_SERVER_URL=http://192.168.1.100:8000

# Local NFC service on the same Raspberry Pi.
VITE_NFC_SERVICE_URL=http://127.0.0.1:5000
VITE_NFC_MODE=hardware
VITE_NFC_COOLDOWN_MS=2500

# Portal URL used in QR links. Must be the network address visible to student phones.
VITE_WEB_APP_BASE_URL=http://192.168.1.100:5176

# Cabinet UI runtime.
HOST=127.0.0.1
PORT=5173
