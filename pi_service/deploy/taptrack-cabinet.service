[Unit]
Description=TapTrack Cabinet UI
After=local-fs.target
Wants=taptrack-nfc.service

[Service]
Type=simple
User=taptrack
WorkingDirectory=/home/taptrack/tap-track/cabinet
RuntimeDirectory=taptrack-cabinet
RuntimeDirectoryMode=0700
ExecStartPre=/usr/bin/python3 /home/taptrack/tap-track/cabinet/deploy/render_device_api_key.py /etc/taptrack/nfc.env /run/taptrack-cabinet/cabinet-device-key.conf
ExecStartPre=/usr/bin/test -f /home/taptrack/tap-track/cabinet/dist/index.html
ExecStart=/usr/sbin/nginx -p /home/taptrack/tap-track/cabinet/ -c /home/taptrack/tap-track/cabinet/deploy/nginx.conf -g 'daemon off;'
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
