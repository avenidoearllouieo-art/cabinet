# Local development can use the Vite proxy.
VITE_DJANGO_API_BASE_URL=/api

# Must exactly match backend/.env DEVICE_API_KEY during local development.
# Do not commit the real value.
VITE_DJANGO_API_KEY=replace-with-development-device-key

# Network-accessible TapTrack Portal URL embedded in the registration QR.
VITE_WEB_APP_BASE_URL=http://192.168.1.100:5176

# Used only when VITE_DJANGO_API_BASE_URL is set to /api.
VITE_DJANGO_SERVER_URL=http://127.0.0.1:8000

# Optional local NFC service. Set this on Raspberry Pi or when testing the
# service locally; leave empty to use only the Mock NFC UID form.
VITE_NFC_SERVICE_URL=http://127.0.0.1:5000
VITE_NFC_MODE=mock
VITE_NFC_COOLDOWN_MS=2500

# Raspberry Pi deployment: replace this with the reachable Django host and
# rebuild. Do not use localhost unless Django is running on the Pi.
# VITE_DJANGO_API_BASE_URL=http://192.168.1.100:8000/api

