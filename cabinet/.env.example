# Local development can use the Vite proxy.
VITE_DJANGO_API_BASE_URL=/api

# Used only when VITE_DJANGO_API_BASE_URL is set to /api.
VITE_DJANGO_SERVER_URL=http://127.0.0.1:8000

# Same-origin paths are proxied by the Cabinet server to its Pi-local services.
VITE_NFC_BRIDGE_URL=/nfc-bridge/api/scans
VITE_NFC_COOLDOWN_MS=2500

# Raspberry Pi deployment: set the reachable Django URL and rebuild. Loopback
# is correct only when Django runs on the Pi. Never put API keys in VITE_ vars.
# VITE_DJANGO_API_BASE_URL=http://<django-host>:8000/api
