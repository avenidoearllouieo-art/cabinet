# Browser requests remain same-origin. The production Nginx server forwards
# /api to the deployed Django API and /nfc-bridge to the Pi-local NFC service.
VITE_DJANGO_API_BASE_URL=/api

# Development-only Vite proxy target. It is not needed for the production build.
VITE_DJANGO_SERVER_URL=http://127.0.0.1:8000

# Same-origin path to the Pi-local NFC bridge.
VITE_NFC_BRIDGE_URL=/nfc-bridge/api/scans
VITE_NFC_COOLDOWN_MS=2500
